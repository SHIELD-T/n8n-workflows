{
  "name": "Day 15 Solution: Triggers vs. Actions",
  "description": "Three trigger-to-action chains (Manual, Webhook+IF, Schedule) demonstrating that triggers start execution while action nodes control branching.",
  "tags": [
    "week-03",
    "day-15",
    "solution"
  ],
  "version": "1.0.0",
  "nodes": [
    {
      "id": "sticky1",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        40,
        -320
      ],
      "parameters": {
        "content": "## Day 15 Solution: Triggers vs. Actions\n\nThree workflows showing trigger vs action separation: (1) Manual -> Set -> Set (action chain), (2) Webhook -> IF -> Set/Respond (action chain with a validation error branch), (3) Schedule -> Set (action chain). Credentials needed: None needed to test the logic.\n\nSee DAILY_TASKS/DAY_15_Triggers_vs_Actions.md.",
        "height": 300,
        "width": 500
      }
    },
    {
      "id": "trigger1",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        80,
        100
      ],
      "parameters": {}
    },
    {
      "id": "set1",
      "name": "Set Sample Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        320,
        100
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "user_name",
              "value": "John Doe"
            },
            {
              "name": "user_email",
              "value": "john@example.com"
            },
            {
              "name": "action_type",
              "value": "manual_trigger"
            }
          ]
        }
      }
    },
    {
      "id": "set2",
      "name": "Process Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        560,
        100
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "processed_name",
              "value": "={{ $json.user_name.toUpperCase() }}"
            },
            {
              "name": "processed_email",
              "value": "={{ $json.user_email.toLowerCase() }}"
            },
            {
              "name": "processed_at",
              "value": "={{ $now }}"
            }
          ]
        }
      }
    },
    {
      "id": "webhook1",
      "name": "Trigger Actions Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        80,
        340
      ],
      "parameters": {
        "path": "trigger-actions",
        "httpMethod": "POST"
      }
    },
    {
      "id": "if1",
      "name": "Validate Input",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        320,
        340
      ],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.data }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      }
    },
    {
      "id": "set3",
      "name": "Process Input",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        560,
        280
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "processed_data",
              "value": "={{ $json.data.trim() }}"
            },
            {
              "name": "action_type",
              "value": "webhook_trigger"
            }
          ]
        }
      }
    },
    {
      "id": "resp1",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        800,
        280
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"success\", \"processed_data\": $json.processed_data } }}"
      }
    },
    {
      "id": "set4",
      "name": "Handle Empty Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        560,
        440
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "status",
              "value": "error"
            }
          ]
        }
      }
    },
    {
      "id": "resp2",
      "name": "Respond Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        800,
        440
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"error\", \"message\": \"data field is empty\" } }}",
        "options": {
          "responseCode": 400
        }
      }
    },
    {
      "id": "sched1",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        80,
        580
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "set5",
      "name": "Collect Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        320,
        580
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "report_type",
              "value": "scheduled_collection"
            },
            {
              "name": "generated_at",
              "value": "={{ $now }}"
            },
            {
              "name": "status",
              "value": "Completed"
            }
          ]
        }
      }
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Set Sample Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Sample Data": {
      "main": [
        [
          {
            "node": "Process Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Trigger Actions Webhook": {
      "main": [
        [
          {
            "node": "Validate Input",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Input": {
      "main": [
        [
          {
            "node": "Process Input",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Handle Empty Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process Input": {
      "main": [
        [
          {
            "node": "Respond Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Handle Empty Data": {
      "main": [
        [
          {
            "node": "Respond Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Collect Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
