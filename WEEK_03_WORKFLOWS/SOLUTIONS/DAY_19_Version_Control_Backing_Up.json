        "assignments": {
          "assignments": [
            {
              "name": "note",
              "value": "Workflows are exported via menu -> Download, named [category]-[function]-v1-[date].json, and stored under n8n-backups/YYYYMMDD/ so any teammate can find the latest backup by date."
            }
          ]
        }
      }
    }
