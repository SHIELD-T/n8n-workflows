  "nodes": [
    {
      "id": "sticky-sticky-note",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        220,
        40
      ],
      "parameters": {
        "content": "## Data Processing Workflow\n\nAdvanced data processing workflow demonstrating complex transformations, data validation, and format conversions. Perfect for Week 4 data processing mastery.\n\n**Credentials needed before running:** None — this workflow only uses built-in nodes and/or public test APIs (no login required).\n\n**How to use:** Import into n8n, add the credentials above under *Credentials*, then run manually (or trigger it) to test.",
        "height": 300,
        "width": 420
      }
    },
    {
      "name": "Data Processing Trigger",
      "type": "n8n-nodes-base.webhook",
      "parameters": {
        "path": "data-processing",
        "httpMethod": "POST"
      },
      "id": "data-processing-trigger",
      "typeVersion": 2,
      "position": [
        240,
        300
      ]
    },
    {
      "name": "Initialize Data Processing",
      "type": "n8n-nodes-base.set",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "processing_id",
              "value": "={{ $now.format('YYYYMMDDHHmmss') }}"
            },
            {
              "name": "data_type",
              "value": "json_to_csv"
            },
            {
              "name": "start_time",
              "value": "={{ $now }}"
            },
            {
              "name": "sample_data",
              "value": "={{ [{\"id\": 1, \"name\": \"John Doe\", \"email\": \"john@example.com\", \"age\": 30}, {\"id\": 2, \"name\": \"Jane Smith\", \"email\": \"jane@example.com\", \"age\": 25}, {\"id\": 3, \"name\": \"Bob Johnson\", \"email\": \"bob@example.com\", \"age\": 35}] }}"
            }
          ]
        }
      },
      "id": "initialize-data-processing",
      "typeVersion": 3.4,
      "position": [
        480,
        300
      ]
    },
    {
      "name": "Validate Input Data",
      "type": "n8n-nodes-base.if",
      "parameters": {
        "conditions": {
          "array": [
            {
              "value1": "={{ $json.sample_data }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "validate-input-data",
      "typeVersion": 2,
      "position": [
        720,
        300
      ]
    },
    {
      "name": "Clean and Validate Data",
      "type": "n8n-nodes-base.set",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "cleaned_data",
              "value": "={{ $json.sample_data.filter(item => item.name && item.email && item.age) }}"
            },
            {
              "name": "validation_status",
              "value": "passed"
            },
            {
              "name": "cleaned_count",
              "value": "={{ $json.sample_data.filter(item => item.name && item.email && item.age).length }}"
            }
          ]
        }
      },
      "id": "clean-and-validate-data",
      "typeVersion": 3.4,
      "position": [
        960,
        300
      ]
    },
    {
      "name": "Transform to CSV Format",
      "type": "n8n-nodes-base.set",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "csv_headers",
              "value": "id,name,email,age"
            },
            {
              "name": "csv_rows",
              "value": "={{ $json.cleaned_data.map(item => `${item.id},${item.name},${item.email},${item.age}`).join('\\n') }}"
            },
            {
              "name": "csv_content",
              "value": "={{ $json.csv_headers + '\\n' + $json.csv_rows }}"
            }
          ]
        }
      },
      "id": "transform-to-csv-format",
      "typeVersion": 3.4,
      "position": [
        1200,
        300
      ]
    },
    {
      "name": "Process Individual Records",
      "type": "n8n-nodes-base.splitInBatches",
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "process-individual-records",
      "typeVersion": 3,
      "position": [
        1920,
        300
      ]
    },
    {
      "name": "Enhance Record Data",
      "type": "n8n-nodes-base.set",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "enhanced_record",
              "value": "={{ { \"id\": $json.id, \"name\": $json.name.trim().toUpperCase(), \"email\": $json.email.toLowerCase().trim(), \"age\": $json.age, \"age_group\": $json.age > 30 ? \"adult\" : \"young_adult\", \"processed_at\": $now } }}"
            },
            {
              "name": "record_status",
              "value": "enhanced"
            }
          ]
        }
      },
      "id": "enhance-record-data",
      "typeVersion": 3.4,
      "position": [
        1680,
        300
      ]
    },
    {
      "name": "Generate Final CSV",
      "type": "n8n-nodes-base.set",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "final_csv",
              "value": "id,name,email,age,age_group,processed_at\\n{{ $json.enhanced_record.id }},{{ $json.enhanced_record.name }},{{ $json.enhanced_record.email }},{{ $json.enhanced_record.age }},{{ $json.enhanced_record.age_group }},{{ $json.enhanced_record.processed_at }}"
            },
            {
              "name": "csv_filename",
              "value": "processed_data_{{ $now.format('YYYYMMDDHHmmss') }}.csv"
            },
            {
              "name": "generation_time",
              "value": "={{ $now }}"
            }
          ]
        }
      },
      "id": "generate-final-csv",
      "typeVersion": 3.4,
      "position": [
        1680,
        480
      ]
    },
    {
      "name": "Handle Validation Error",
      "type": "n8n-nodes-base.set",
      "position": [
        500,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "validation_error",
              "value": "={{ { \"error_type\": \"data_validation\", \"message\": \"Invalid input data provided\", \"timestamp\": $now } }}"
            },
            {
              "name": "error_status",
              "value": "failed"
            }
          ]
        }
      },
      "id": "handle-validation-error",
      "typeVersion": 3.4
    }
  ],
  "connections": {
