  "nodes": [
    {
      "id": "sticky-sticky-note",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        220,
        40
      ],
      "parameters": {
        "content": "## Advanced Pattern Workflow\n\nAdvanced pattern workflow demonstrating parallel processing, loops, and complex workflow architectures. Perfect for Week 4 advanced workflow patterns mastery.\n\n**Credentials needed before running:** None — this workflow only uses built-in nodes and/or public test APIs (no login required).\n\n**How to use:** Import into n8n, add the credentials above under *Credentials*, then run manually (or trigger it) to test.",
        "height": 300,
        "width": 420
      }
    },
    {
      "name": "Advanced Pattern Trigger",
      "type": "n8n-nodes-base.webhook",
      "parameters": {
        "path": "advanced-patterns",
        "httpMethod": "POST"
      },
      "id": "advanced-pattern-trigger",
      "typeVersion": 2,
      "position": [
        240,
        300
      ]
    },
    {
      "name": "Initialize Advanced Processing",
      "type": "n8n-nodes-base.set",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "processing_id",
              "value": "={{ $now.format('YYYYMMDDHHmmss') }}"
            },
            {
              "name": "pattern_type",
              "value": "parallel_processing"
            },
            {
              "name": "start_time",
              "value": "={{ $now }}"
            },
            {
              "name": "data_sources",
              "value": "={{ ['source1', 'source2', 'source3'] }}"
            }
          ]
        }
      },
      "id": "initialize-advanced-processing",
      "typeVersion": 3.4,
      "position": [
        480,
        300
      ]
    },
    {
      "name": "Parallel Branch 1",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "GET",
        "url": "https://jsonplaceholder.typicode.com/posts/1",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "parallel-branch-1",
      "typeVersion": 4.2,
      "position": [
        720,
        300
      ]
    },
    {
      "name": "Parallel Branch 2",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "GET",
        "url": "https://jsonplaceholder.typicode.com/posts/2",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "parallel-branch-2",
      "typeVersion": 4.2,
      "position": [
        720,
        480
      ]
    },
    {
      "name": "Parallel Branch 3",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "GET",
        "url": "https://jsonplaceholder.typicode.com/posts/3",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "parallel-branch-3",
      "typeVersion": 4.2,
      "position": [
        720,
        660
      ]
    },
    {
      "name": "Process Branch 1",
      "type": "n8n-nodes-base.set",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "branch_1_data",
              "value": "={{ { \"id\": $json.id, \"title\": $json.title, \"body\": $json.body, \"source\": \"branch1\", \"processed_at\": $now } }}"
            },
            {
              "name": "branch_1_status",
              "value": "processed"
            }
          ]
        }
      },
      "id": "process-branch-1",
      "typeVersion": 3.4,
      "position": [
        960,
        300
      ]
    },
    {
      "name": "Process Branch 2",
      "type": "n8n-nodes-base.set",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "branch_2_data",
              "value": "={{ { \"id\": $json.id, \"title\": $json.title, \"body\": $json.body, \"source\": \"branch2\", \"processed_at\": $now } }}"
            },
            {
              "name": "branch_2_status",
              "value": "processed"
            }
          ]
        }
      },
      "id": "process-branch-2",
      "typeVersion": 3.4,
      "position": [
        960,
        480
      ]
    },
    {
      "name": "Process Branch 3",
      "type": "n8n-nodes-base.set",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "branch_3_data",
              "value": "={{ { \"id\": $json.id, \"title\": $json.title, \"body\": $json.body, \"source\": \"branch3\", \"processed_at\": $now } }}"
            },
            {
              "name": "branch_3_status",
              "value": "processed"
            }
          ]
        }
      },
      "id": "process-branch-3",
      "typeVersion": 3.4,
      "position": [
        960,
        660
      ]
    },
    {
      "name": "Aggregate Results",
      "type": "n8n-nodes-base.set",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "aggregated_data",
              "value": "={{ { \"branch1\": $('Process Branch 1').item.json.branch_1_data, \"branch2\": $('Process Branch 2').item.json.branch_2_data, \"branch3\": $('Process Branch 3').item.json.branch_3_data } }}"
            },
            {
              "name": "total_branches",
              "value": 3
            },
            {
              "name": "aggregation_time",
              "value": "={{ $now }}"
            }
          ]
        }
      },
      "id": "aggregate-results",
      "typeVersion": 3.4,
      "position": [
        1200,
        300
      ]
    },
    {
      "name": "Loop Through Results",
      "type": "n8n-nodes-base.splitInBatches",
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "loop-through-results",
      "typeVersion": 3,
      "position": [
        1920,
        300
      ]
    },
    {
      "name": "Process Each Result",
      "type": "n8n-nodes-base.set",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "current_result",
              "value": "={{ $json }}"
            },
            {
              "name": "result_id",
              "value": "={{ $json.id || 'unknown' }}"
            },
            {
              "name": "processed_in_loop",
              "value": "={{ $now }}"
            }
          ]
        }
      },
      "id": "process-each-result",
      "typeVersion": 3.4,
      "position": [
        1680,
        300
      ]
    },
    {
      "name": "Final Processing",
      "type": "n8n-nodes-base.set",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "final_result",
              "value": "={{ { \"processing_id\": $json.processing_id, \"pattern_type\": $json.pattern_type, \"total_branches\": $json.total_branches, \"aggregated_data\": $json.aggregated_data, \"current_result\": $json.current_result, \"completed_at\": $now } }}"
            },
            {
              "name": "success_message",
              "value": "✅ Advanced pattern processing completed"
            }
          ]
        }
      },
      "id": "final-processing",
      "typeVersion": 3.4,
      "position": [
        1680,
        480
      ]
    }
  ],
