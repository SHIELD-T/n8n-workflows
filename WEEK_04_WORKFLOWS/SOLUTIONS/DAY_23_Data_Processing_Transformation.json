            "index": 0
          }
        ]
      ]
    },
    "Transform to CSV Format": {
      "main": [
        [
          {
            "node": "Split Cleaned to Items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split Cleaned to Items": {
      "main": [
        [
          {
            "node": "Loop Records",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Loop Records": {
      "main": [
        [
          {
            "node": "Generate Final CSV",
