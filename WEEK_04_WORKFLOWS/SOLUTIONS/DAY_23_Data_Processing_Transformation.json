{
  "name": "Day 23 Solution: Data Processing and Transformation",
  "description": "JSON-to-CSV pipeline: validate -> filter incomplete records -> transform to CSV -> enhance each record while looping -> generate final CSV.",
  "tags": [
    "week-04",
    "day-23",
    "solution"
  ],
  "version": "1.0.0",
  "nodes": [
    {
      "id": "sticky1",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        40,
        -320
      ],
      "parameters": {
        "content": "## Day 23 Solution: Data Processing and Transformation\n\nManual -> Set (hardcoded JSON array) -> IF array not empty -> Set (filter valid records) -> Set (build CSV) -> Split In Batches -> Set (enhance each record) -> Set (final CSV). Credentials needed: None — all sample data is hardcoded.\n\nSee DAILY_TASKS/DAY_23_Data_Processing_Transformation.md.",
        "height": 300,
        "width": 520
      }
    },
    {
      "id": "trigger1",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        80,
        200
      ],
      "parameters": {}
    },
    {
      "id": "set1",
      "name": "Set Sample JSON Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        320,
        200
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "json_data",
              "value": "={{ [{\"id\":1,\"name\":\"John Doe\",\"email\":\"john@example.com\",\"age\":30,\"city\":\"New York\"},{\"id\":2,\"name\":\"Jane Smith\",\"email\":\"jane@example.com\",\"age\":25,\"city\":\"Los Angeles\"},{\"id\":3,\"name\":\"Bob Johnson\",\"email\":\"bob@example.com\",\"age\":35,\"city\":\"Chicago\"},{\"id\":4,\"name\":\"Incomplete Record\",\"age\":40,\"city\":\"Miami\"}] }}"
            }
          ]
        }
      }
    },
    {
      "id": "if1",
      "name": "Validate JSON Data",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        560,
        200
      ],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.json_data }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      }
    },
    {
      "id": "set2",
      "name": "Clean and Validate Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        800,
        140
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "cleaned_data",
              "value": "={{ $json.json_data.filter(item => item.name && item.email && item.age) }}"
            },
            {
              "name": "cleaned_count",
              "value": "={{ $json.json_data.filter(item => item.name && item.email && item.age).length }}"
            }
          ]
        }
      }
    },
    {
      "id": "set3",
      "name": "Transform to CSV Format",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1040,
        140
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "csv_headers",
              "value": "id,name,email,age,city"
            },
            {
              "name": "csv_rows",
              "value": "={{ $json.cleaned_data.map(item => `${item.id},${item.name},${item.email},${item.age},${item.city}`).join('\\n') }}"
            }
          ]
        }
      }
    },
    {
      "id": "code1",
      "name": "Split Cleaned to Items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        140
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return items[0].json.cleaned_data.map(r => ({ json: r }));"
      }
    },
    {
      "id": "sib1",
      "name": "Loop Records",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        1520,
        140
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "set4",
      "name": "Enhance Record Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1760,
        140
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "enhanced_age_group",
              "value": "={{ $json.age > 30 ? 'adult' : 'young_adult' }}"
            },
            {
              "name": "enhanced_email",
              "value": "={{ $json.email.toLowerCase().trim() }}"
            }
          ]
        }
      }
    },
    {
      "id": "set5",
      "name": "Generate Final CSV",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        2000,
        140
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "csv_content",
              "value": "={{ 'id,name,email,age,city\\n' + $('Transform to CSV Format').item.json.csv_rows }}"
            },
            {
              "name": "csv_filename",
              "value": "={{ 'processed_data_' + $now.format('yyyyMMddHHmmss') + '.csv' }}"
            }
          ]
        }
      }
    },
    {
      "id": "set6",
      "name": "Handle Validation Error",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        800,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "error",
              "value": "json_data array was empty"
            }
          ]
        }
      }
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
