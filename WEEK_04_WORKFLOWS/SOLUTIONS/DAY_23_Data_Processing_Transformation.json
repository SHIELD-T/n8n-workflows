      ]
    },
    "Set Sample JSON Data": {
      "main": [
        [
          {
            "node": "Validate JSON Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate JSON Data": {
      "main": [
        [
          {
            "node": "Clean and Validate Data",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Handle Validation Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Clean and Validate Data": {
      "main": [
        [
          {
            "node": "Transform to CSV Format",
