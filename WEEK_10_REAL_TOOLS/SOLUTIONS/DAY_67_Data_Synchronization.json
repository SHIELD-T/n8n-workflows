    "Lookup Existing Airtable Row": { "main": [[ { "node": "Conflict Check - Last Updated Wins", "type": "main", "index": 0 } ]] },
    "Conflict Check - Last Updated Wins": { "main": [[ { "node": "Row Already Exists?", "type": "main", "index": 0 } ]] },
    "Row Already Exists?": {
      "main": [
        [ { "node": "Update Airtable Row", "type": "main", "index": 0 } ],
