    "Worker - Notify Sales Trigger": { "main": [[ { "node": "Notify Sales Team", "type": "main", "index": 0 } ]] },

    "Manual Trigger": { "main": [[ { "node": "Call Validate Lead", "type": "main", "index": 0 } ]] },
    "Call Validate Lead": { "main": [[ { "node": "Call Enrich Lead", "type": "main", "index": 0 } ]] },
    "Call Enrich Lead": { "main": [[ { "node": "Call Log to Airtable", "type": "main", "index": 0 }, { "node": "Call Post Slack Update", "type": "main", "index": 0 } ]] },
    "Call Log to Airtable": { "main": [[ { "node": "Lead Score Above Threshold?", "type": "main", "index": 0 } ]] },
    "Call Post Slack Update": { "main": [[ { "node": "Lead Score Above Threshold?", "type": "main", "index": 0 } ]] },
    "Lead Score Above Threshold?": {
      "main": [
        [ { "node": "Call Notify Sales (Conditional)", "type": "main", "index": 0 } ],
        [ { "node": "Skip - Score Too Low", "type": "main", "index": 0 } ]
      ]
    },
    "Call Notify Sales (Conditional)": { "main": [[ { "node": "Aggregate Run Summary", "type": "main", "index": 0 } ]] },
    "Skip - Score Too Low": { "main": [[ { "node": "Aggregate Run Summary", "type": "main", "index": 0 } ]] }
  },
