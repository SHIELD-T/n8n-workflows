      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "orchestration_id",
              "value": "={{ $now.format('YYYYMMDDHHmmss') }}"
            },
            {
              "name": "orchestration_type",
              "value": "advanced"
            },
            {
              "name": "start_time",
              "value": "={{ $now }}"
            },
            {
              "name": "services",
              "value": "={{ ['service_a', 'service_b', 'service_c', 'service_d', 'service_e'] }}"
