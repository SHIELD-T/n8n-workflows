            {
              "name": "data_quality_score",
              "value": "={{ Math.round(($('⚠️ Service A Integration (placeholder)').item.json.quality_score + $('⚠️ Service B Integration (placeholder)').item.json.quality_score + $('⚠️ Service C Integration (placeholder)').item.json.quality_score + $('⚠️ Service D Integration (placeholder)').item.json.quality_score + $('⚠️ Service E Integration (placeholder)').item.json.quality_score) / 5) }}"
