{
  "name": "Day 33 Solution: Production Optimization Review",
  "description": "Production Orchestrator calling the Day 29-31 workflows via Execute Workflow nodes and reporting a combined health verdict.",
  "tags": [
    "week-05",
    "day-33",
    "solution"
  ],
  "version": "1.0.0",
  "nodes": [
    {
      "id": "sticky1",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        40,
        -360
      ],
      "parameters": {
        "content": "## Day 33 Solution: Production Optimization Review\n\nOrchestrator with two entry points (Webhook + Schedule for testing) calling your Day 29/30/31 workflows via Execute Workflow nodes, then aggregating overall_production_health and posting the report to webhook.site. Select each Execute Workflow node's target from the dropdown by name after importing all four Week 5 solution files into your instance. Credentials needed: None — this orchestrates workflows you already built.\n\nSee DAILY_TASKS/DAY_33_Production_Optimization_Review.md.",
        "height": 340,
        "width": 560
      }
    },
    {
      "id": "webhook1",
      "name": "Orchestrator Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        80,
        220
      ],
      "parameters": {
        "path": "production-orchestrator",
        "httpMethod": "POST"
      }
    },
    {
      "id": "sched1",
      "name": "Orchestrator Test Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        80,
        380
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "set1",
      "name": "Initialize Production System",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        320,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "system_id",
              "value": "={{ $now.format('yyyyMMddHHmmss') }}"
            },
            {
              "name": "system_version",
              "value": "5.0-production"
            }
          ]
        }
      }
    },
    {
      "id": "exec1",
      "name": "Execute: Production Deployment Pipeline",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        560,
        140
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "Day 29 Solution: Production Workflow Deployment Strategies",
          "mode": "list",
          "cachedResultName": "Day 29 Solution: Production Workflow Deployment Strategies"
        }
      }
    },
    {
      "id": "exec2",
      "name": "Execute: Scalable Load Handler",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        560,
        300
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "Day 30 Solution: Scaling Automation Systems",
          "mode": "list",
          "cachedResultName": "Day 30 Solution: Scaling Automation Systems"
        }
      }
    },
    {
      "id": "exec3",
      "name": "Execute: Automated Maintenance Sweep",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        560,
        460
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "Day 31 Solution: Workflow Optimization & Maintenance",
          "mode": "list",
          "cachedResultName": "Day 31 Solution: Workflow Optimization & Maintenance"
        }
      }
    },
    {
      "id": "set2",
      "name": "Analyze Production Status",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        800,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "overall_production_health",
              "value": "={{ ($('Execute: Production Deployment Pipeline').item && $('Execute: Scalable Load Handler').item && $('Execute: Automated Maintenance Sweep').item) ? 'excellent' : 'needs_attention' }}"
            }
          ]
        }
      }
    },
    {
      "id": "http1",
      "name": "Send Production Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1040,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://webhook.site/your-unique-id",
        "sendBody": true,
        "bodyContentType": "json",
        "jsonBody": "={{ { system_id: $('Initialize Production System').item.json.system_id, overall_production_health: $json.overall_production_health } }}"
      }
    }
  ],
  "connections": {
    "Orchestrator Webhook": {
      "main": [
        [
          {
            "node": "Initialize Production System",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Orchestrator Test Schedule": {
      "main": [
        [
          {
            "node": "Initialize Production System",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Initialize Production System": {
      "main": [
        [
          {
            "node": "Execute: Production Deployment Pipeline",
            "type": "main",
            "index": 0
          },
          {
            "node": "Execute: Scalable Load Handler",
            "type": "main",
            "index": 0
          },
          {
            "node": "Execute: Automated Maintenance Sweep",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Execute: Production Deployment Pipeline": {
      "main": [
        [
          {
            "node": "Analyze Production Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Execute: Scalable Load Handler": {
      "main": [
        [
          {
            "node": "Analyze Production Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Execute: Automated Maintenance Sweep": {
      "main": [
        [
          {
            "node": "Analyze Production Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Analyze Production Status": {
      "main": [
        [
          {
            "node": "Send Production Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {},
  "pinData": {},
  "versionId": "1",
  "id": "day_33_solution"
}