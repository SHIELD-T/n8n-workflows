{
  "name": "Day 05 Solution: Exploring n8n UI",
  "description": "Three workflows for practicing Execution History, Pin Data, and IF branching: data cleaning, webhook routing, scheduled report.",
  "tags": [
    "week-01",
    "day-05",
    "solution"
  ],
  "version": "1.0.0",
  "nodes": [
    {
      "id": "sticky1",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        40,
        -280
      ],
      "parameters": {
        "content": "## Day 05 Solution: Exploring n8n UI\n\nThree workflows: (1) Manual -> IF -> two Set transforms (try Pin Data on the trigger with {\"data\":\"hello world automation\"}), (2) Webhook -> IF branch by type -> Respond, (3) Schedule report. Use these to practice Execution History and Pin Data.\n\nCredentials needed: None needed to test the logic.\n\nSee DAILY_TASKS/DAY_05_Exploring_UI.md.",
        "height": 260,
        "width": 480
      }
    },
    {
      "id": "trigger1",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        80,
        100
      ],
      "parameters": {}
    },
    {
      "id": "if1",
      "name": "Input Validation",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        320,
        100
      ],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.data }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      }
    },
    {
      "id": "set1",
      "name": "Step 1: Data Cleaning",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        560,
        40
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "cleaned_data",
              "value": "={{ $json.data.trim().toLowerCase() }}"
            }
          ]
        }
      }
    },
    {
      "id": "set2",
      "name": "Step 2: Data Processing",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        800,
        40
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "processed_data",
              "value": "={{ $json.cleaned_data.split(' ').length }}"
            }
          ]
        }
      }
    },
    {
      "id": "set3",
      "name": "Validation Failed",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        560,
        200
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "error",
              "value": "Input data is empty"
            }
          ]
        }
      }
    },
    {
      "id": "webhook1",
      "name": "Conditional Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        80,
        380
      ],
      "parameters": {
        "path": "conditional-processing",
        "httpMethod": "POST"
      }
    },
    {
      "id": "if2",
      "name": "Route by Type",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        320,
        380
      ],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.type }}",
              "operation": "equal",
              "value2": "urgent"
            }
          ]
        }
      }
    },
    {
      "id": "set4",
      "name": "Urgent Processing",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        560,
        320
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "priority",
              "value": "HIGH"
            }
          ]
        }
      }
    },
    {
      "id": "set5",
      "name": "Normal Processing",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        560,
        460
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "priority",
              "value": "NORMAL"
            }
          ]
        }
      }
    },
    {
      "id": "resp1",
      "name": "Respond With Priority",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        800,
        380
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"success\", \"priority\": $json.priority } }}"
      }
    },
    {
      "id": "sched1",
      "name": "Schedule Report Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        80,
        620
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "set6",
      "name": "Generate Report",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        320,
        620
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "report_id",
              "value": "={{ $now.format('YYYY-MM-DD-HH') }}"
            },
            {
              "name": "status",
              "value": "Completed"
            }
          ]
        }
      }
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Input Validation",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Input Validation": {
      "main": [
        [
          {
            "node": "Step 1: Data Cleaning",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Validation Failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Step 1: Data Cleaning": {
      "main": [
        [
          {
            "node": "Step 2: Data Processing",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Conditional Webhook": {
      "main": [
        [
          {
            "node": "Route by Type",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Route by Type": {
      "main": [
        [
          {
            "node": "Urgent Processing",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Normal Processing",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Urgent Processing": {
      "main": [
        [
          {
            "node": "Respond With Priority",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normal Processing": {
      "main": [
        [
          {
            "node": "Respond With Priority",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Schedule Report Trigger": {
      "main": [
        [
          {
            "node": "Generate Report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
