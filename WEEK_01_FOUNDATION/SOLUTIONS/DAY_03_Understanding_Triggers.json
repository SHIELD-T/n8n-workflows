{
  "name": "Day 03 Solution: Understanding Triggers",
  "description": "Three trigger types in one file: Manual, Webhook (with IF validation + response), and Schedule.",
  "tags": [
    "week-01",
    "day-03",
    "solution"
  ],
  "version": "1.0.0",
  "nodes": [
    {
      "id": "sticky1",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        40,
        -260
      ],
      "parameters": {
        "content": "## Day 03 Solution: Understanding Triggers\n\nThree independent workflows in one file: (1) Manual trigger chain, (2) Webhook + IF + Set + Respond, (3) Schedule trigger chain. Test the webhook branch with curl against the Test URL, then Activate to get a Production URL.\n\nCredentials needed: None needed to test the logic.\n\nSee DAILY_TASKS/DAY_03_Understanding_Triggers.md.",
        "height": 260,
        "width": 480
      }
    },
    {
      "id": "trigger1",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        80,
        100
      ],
      "parameters": {}
    },
    {
      "id": "set1",
      "name": "Set Manual Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        320,
        100
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "message",
              "value": "Manual trigger executed!"
            },
            {
              "name": "timestamp",
              "value": "={{ $now }}"
            }
          ]
        }
      }
    },
    {
      "id": "webhook1",
      "name": "Test Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        80,
        340
      ],
      "parameters": {
        "path": "test-webhook",
        "httpMethod": "POST"
      }
    },
    {
      "id": "if1",
      "name": "Check Payload Not Empty",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        320,
        340
      ],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.name }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      }
    },
    {
      "id": "set2",
      "name": "Process Webhook Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        560,
        260
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "received_data",
              "value": "={{ $json }}"
            },
            {
              "name": "processed_at",
              "value": "={{ $now }}"
            }
          ]
        }
      }
    },
    {
      "id": "resp1",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        800,
        260
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"received\", \"data\": $json.received_data } }}"
      }
    },
    {
      "id": "set3",
      "name": "Handle Missing Name",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        560,
        440
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "error",
              "value": "Missing required field: name"
            }
          ]
        }
      }
    },
    {
      "id": "resp2",
      "name": "Respond Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        800,
        440
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"error\", \"message\": \"Missing name field\" } }}",
        "options": {
          "responseCode": 400
        }
      }
    },
    {
      "id": "sched1",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        80,
        600
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "set4",
      "name": "Collect Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        320,
        600
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "report_type",
              "value": "scheduled_report"
            },
            {
              "name": "generated_at",
              "value": "={{ $now }}"
            },
            {
              "name": "status",
              "value": "Completed"
            }
          ]
        }
      }
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Set Manual Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Test Webhook": {
      "main": [
        [
          {
            "node": "Check Payload Not Empty",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Payload Not Empty": {
      "main": [
        [
          {
            "node": "Process Webhook Data",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Handle Missing Name",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process Webhook Data": {
      "main": [
        [
          {
            "node": "Respond Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Handle Missing Name": {
      "main": [
        [
          {
            "node": "Respond Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Collect Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {},
  "pinData": {},
  "versionId": "1",
  "id": "day_03_solution"
}