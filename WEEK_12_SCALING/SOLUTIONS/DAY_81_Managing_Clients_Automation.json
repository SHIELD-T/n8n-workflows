    {
      "id": "0bfe6b24-498e-4b3d-8b7f-541a53fc737c",
      "name": "Fetch n8n Executions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        40,
        700
      ],
      "parameters": {
        "method": "GET",
        "url": "https://YOUR-N8N-INSTANCE.example/api/v1/executions?limit=250",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-API-KEY",
              "value": "YOUR_N8N_API_KEY"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "a3b09f1d-ecb4-40ae-962d-d51f3707ecc8",
      "name": "Compute Report Metrics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        280,
        700
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const body = items[0].json;\nconst executions = Array.isArray(body.data) ? body.data : (Array.isArray(body) ? body : []);\nconst weekAgo = Date.now() - 7 * 24 * 60 * 60 * 1000;\nconst thisWeek = executions.filter(e => new Date(e.startedAt).getTime() >= weekAgo);\nconst total = thisWeek.length;\nconst success = thisWeek.filter(e => e.status === 'success' || e.finished === true).length;\nconst failed = total - success;\nconst successRate = total > 0 ? Math.round((success / total) * 1000) / 10 : 0;\nreturn [{ json: { total_executions: total, successful: success, failed, success_rate_pct: successRate } }];"
      }
    },
    {
      "id": "6bdba50d-ebf2-4485-a6bf-b9c43bded229",
      "name": "Generate Observation",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1.3,
      "position": [
        520,
        700
      ],
      "parameters": {
        "resource": "chat",
        "operation": "create",
        "model": "gpt-4o-mini",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You write one plain-English sentence observing a client's weekly automation performance from real numbers. No filler, no generic praise, cite the actual numbers given."
            },
            {
              "role": "user",
              "content": "={{ 'Total executions: ' + $json.total_executions + ', successful: ' + $json.successful + ', failed: ' + $json.failed + ', success rate: ' + $json.success_rate_pct + '%' }}"
            }
          ]
        },
        "options": {
          "temperature": 0.4,
          "maxTokens": 120
        }
      }
    },
    {
      "id": "0fdf4d42-0fdc-45b9-a3f1-711a908a2b7b",
      "name": "Build Client Report",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        760,
