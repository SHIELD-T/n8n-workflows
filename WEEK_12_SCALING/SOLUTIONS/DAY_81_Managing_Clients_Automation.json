    {
      "id": "fedf2e6c-4e02-44f9-8e07-5ffdc669eab7",
      "name": "Weekly Report Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -200,
