{
  "name": "Day 37 Solution: Advanced AI Workflows",
  "description": "Calls OpenAI (GPT-4o) and Anthropic Claude in parallel off the same Set node, gated by an If node checking text_complexity, then merges both responses and selects a best_response.",
  "tags": [
    "week-06",
    "ai-agents",
    "day-37",
    "openai",
    "anthropic",
    "solution"
  ],
  "version": "1.0.0",
  "nodes": [
    {
      "id": "overview-sticky",
      "name": "Overview Sticky",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        240,
        40
      ],
      "parameters": {
        "content": "## Day 37 Solution: Advanced AI Workflows\n\nCalls two LLM providers in parallel (OpenAI via the OpenAI node, Anthropic Claude via a real HTTP Request call) off the same Set node, branches on text_complexity with an If node, then merges both responses and picks a best_response by length.\n\n**Credentials needed to run for real:** OpenAI API key; an Anthropic API key (sent as the x-api-key header on the HTTP Request node).\n\n**Reference:** WEEK_06_AI_AGENTS/DAILY_TASKS/DAY_37_Advanced_AI_Workflows.md",
        "height": 300,
        "width": 420
      }
    },
    {
      "id": "advanced-ai-workflow-trigger",
      "name": "Advanced AI Workflow Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        380
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "advanced-ai-workflow",
        "options": {}
      }
    },
    {
      "id": "prepare-input",
      "name": "Prepare Input",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        520,
        380
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "input_text",
              "value": "={{ $json.text }}"
            },
            {
              "name": "text_complexity",
              "value": "={{ $json.complexity || 'high' }}"
            }
          ]
        }
      }
    },
    {
      "id": "check-complexity",
      "name": "Check Complexity",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        800,
        380
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.text_complexity }}",
              "rightValue": "high",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "openai-analysis-gpt4o",
      "name": "OpenAI Analysis (GPT-4o)",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1.3,
      "position": [
        1080,
        200
      ],
      "parameters": {
        "resource": "chat",
        "operation": "create",
        "model": "gpt-4o",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are an advanced AI assistant specializing in complex text analysis, summarization, and insights generation."
            },
            {
              "role": "user",
              "content": "={{ $json.input_text }}"
            }
          ]
        },
        "options": {
          "temperature": 0.3,
          "maxTokens": 1000
        }
      }
    },
    {
      "id": "extract-openai-response",
      "name": "Extract OpenAI Response",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1360,
        200
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "openai_response",
              "value": "={{ $json.message.content }}"
            }
          ]
        }
      }
    },
    {
      "id": "claude-analysis-anthropic",
      "name": "Claude Analysis (Anthropic)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1080,
        580
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "YOUR_ANTHROPIC_API_KEY"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "bodyContentType": "json",
        "jsonBody": "={{ { \"model\": \"claude-3-5-sonnet-20241022\", \"max_tokens\": 1000, \"messages\": [ { \"role\": \"user\", \"content\": $json.input_text } ] } }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      }
    },
    {
      "id": "extract-claude-response",
      "name": "Extract Claude Response",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1360,
        580
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "claude_response",
              "value": "={{ $json.content[0].text }}"
            }
          ]
        }
      }
    },
    {
      "id": "combine-responses",
      "name": "Combine Responses",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        1640,
        380
      ],
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "numberInputs": 2,
        "options": {}
      }
    },
    {
      "id": "build-best-response",
      "name": "Build Best Response",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1920,
        380
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "all_responses",
              "value": "={{ { \"openai\": $json.openai_response, \"claude\": $json.claude_response } }}"
            },
            {
              "name": "best_response",
              "value": "={{ $json.openai_response.length > $json.claude_response.length ? $json.openai_response : $json.claude_response }}"
            }
          ]
        }
      }
    }
  ],
  "connections": {
    "Advanced AI Workflow Trigger": {
      "main": [
        [
          {
            "node": "Prepare Input",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Input": {
      "main": [
        [
          {
            "node": "Check Complexity",
            "type": "main",
            "index": 0
          },
          {
            "node": "Claude Analysis (Anthropic)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Complexity": {
      "main": [
        [
          {
            "node": "OpenAI Analysis (GPT-4o)",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "OpenAI Analysis (GPT-4o)": {
      "main": [
        [
          {
            "node": "Extract OpenAI Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract OpenAI Response": {
      "main": [
        [
          {
            "node": "Combine Responses",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claude Analysis (Anthropic)": {
      "main": [
        [
          {
            "node": "Extract Claude Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Claude Response": {
      "main": [
        [
          {
            "node": "Combine Responses",
            "type": "main",
            "index": 1
          }
        ]
      ]
    },
    "Combine Responses": {
      "main": [
        [
          {
            "node": "Build Best Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {},
  "pinData": {},
  "versionId": "1",
  "id": "day_37_solution"
}