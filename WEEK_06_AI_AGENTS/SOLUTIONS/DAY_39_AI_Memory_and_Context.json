        "sessionKey": "={{ $('Memory Chat Trigger').item.json.body.conversation_id }}",
        "contextWindowLength": 10
      }
    },
    {
      "id": "load-kb-trigger",
      "name": "Load Knowledge Base",
      "type": "n8n-nodes-base.manualTrigger",
