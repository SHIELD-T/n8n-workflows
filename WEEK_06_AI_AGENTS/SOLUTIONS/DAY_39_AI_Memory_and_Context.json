        240,
        960
      ],
      "parameters": {}
    },
    {
      "id": "knowledge-base",
      "name": "Knowledge Base",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        480,
        960
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "text",
              "value": "Refunds: Students may request a full refund within 14 days of purchasing a course, provided less than 25% of the course content has been completed. Refund requests after 14 days are evaluated case-by-case and are not guaranteed.\n\nCourse Access: Once enrolled, students have lifetime access to course materials, including any future updates to that course. Access does not expire and is not tied to a subscription.\n\nCertificates: A certificate of completion is issued automatically once a student finishes 100% of a course's required lessons and passes the final assessment with a score of 70% or higher.\n\nSupport Hours: Our support team responds to help-desk tickets Monday through Friday, 9am-6pm Eastern Time, with a target first-response time of one business day. Live chat is available during the same hours for enrolled students."
            }
          ]
        }
      }
    },
