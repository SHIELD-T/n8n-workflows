            "index": 0
          },
          {
            "node": "Image Analysis",
            "type": "main",
            "index": 0
          },
          {
            "node": "Audio Transcription",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Text Analysis": {
      "main": [
        [
          {
            "node": "Combine Modalities",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Image Analysis": {
      "main": [
        [
          {
            "node": "Combine Modalities",
            "type": "main",
            "index": 1
          }
        ]
      ]
    },
    "Audio Transcription": {
      "main": [
        [
          {
            "node": "Combine Modalities",
            "type": "main",
            "index": 2
          }
        ]
      ]
    },
    "Combine Modalities": {
      "main": [
        [
          {
            "node": "Cross-Modal Analysis",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
