  "nodes": [
    {
      "id": "sticky-sticky-note",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        220,
        40
      ],
      "parameters": {
        "content": "## Advanced Triggers Debugging\n\nAdvanced trigger debugging workflow demonstrating multiple trigger types, error handling, and debugging techniques. Ideal for Week 2 advanced trigger concepts.\n\n**Credentials needed before running:** None — this workflow only uses built-in nodes and/or public test APIs (no login required).\n\n**How to use:** Import into n8n, add the credentials above under *Credentials*, then run manually (or trigger it) to test.",
        "height": 300,
        "width": 420
      }
    },
    {
      "name": "Advanced Trigger System",
      "type": "n8n-nodes-base.webhook",
      "parameters": {
        "path": "advanced-triggers",
        "httpMethod": "POST"
      },
      "id": "advanced-trigger-system",
      "typeVersion": 2,
      "position": [
        240,
        300
      ]
    },
    {
      "name": "Schedule Advanced Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 2
            }
          ]
        }
      },
      "id": "schedule-advanced-trigger",
      "typeVersion": 1.2,
      "position": [
        240,
        480
      ]
    },
    {
      "name": "Manual Advanced Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "parameters": {},
      "id": "manual-advanced-trigger",
      "typeVersion": 1,
      "position": [
        240,
        660
      ]
    },
    {
      "name": "Initialize Advanced Processing",
      "type": "n8n-nodes-base.set",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "trigger_id",
              "value": "={{ $now.format('YYYYMMDDHHmmss') }}"
            },
            {
              "name": "trigger_type",
              "value": "advanced_multi_trigger"
            },
            {
              "name": "start_time",
              "value": "={{ $now }}"
            },
            {
              "name": "processing_mode",
              "value": "advanced"
            }
          ]
        }
      },
      "id": "initialize-advanced-processing",
      "typeVersion": 3.4,
      "position": [
        480,
        300
      ]
    },
    {
      "name": "Advanced Data Validation",
      "type": "n8n-nodes-base.if",
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.data || 'default_data' }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "advanced-data-validation",
      "typeVersion": 2,
      "position": [
        720,
        300
      ]
    },
    {
      "name": "Advanced Data Processing",
      "type": "n8n-nodes-base.set",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "processed_data",
              "value": "={{ $json.data || 'default_data' }}"
            },
            {
              "name": "data_length",
              "value": "={{ ($json.data || 'default_data').length }}"
            },
            {
              "name": "processing_time",
              "value": "={{ $now.diff($json.start_time, 'milliseconds') }}"
            },
            {
              "name": "processing_status",
              "value": "advanced_processed"
            }
          ]
        }
      },
      "id": "advanced-data-processing",
      "typeVersion": 3.4,
      "position": [
        960,
        300
      ]
    },
    {
      "name": "Advanced Error Handling",
      "type": "n8n-nodes-base.if",
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.processing_time }}",
              "operation": "larger",
              "value2": 5000
            }
          ]
        }
      },
      "id": "advanced-error-handling",
      "typeVersion": 2,
      "position": [
        1200,
        300
      ]
    },
    {
      "name": "Handle Processing Delay",
      "type": "n8n-nodes-base.set",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "delay_warning",
              "value": "Processing took longer than expected: {{ $json.processing_time }}ms"
            },
            {
              "name": "warning_time",
              "value": "={{ $now }}"
            },
            {
              "name": "warning_status",
              "value": "performance_warning"
            }
          ]
        }
      },
      "id": "handle-processing-delay",
      "typeVersion": 3.4,
      "position": [
        1440,
        300
      ]
    },
    {
      "name": "Advanced Debugging",
      "type": "n8n-nodes-base.set",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "debug_info",
              "value": "={{ { \"trigger_id\": $json.trigger_id, \"trigger_type\": $json.trigger_type, \"processing_time\": $json.processing_time, \"data_length\": $json.data_length, \"processing_status\": $json.processing_status, \"debug_timestamp\": $now } }}"
            },
            {
              "name": "debug_level",
              "value": "advanced"
            }
          ]
        }
      },
      "id": "advanced-debugging",
      "typeVersion": 3.4,
      "position": [
        1680,
        300
      ]
    },
    {
      "name": "Advanced Result Processing",
      "type": "n8n-nodes-base.set",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "final_result",
              "value": "={{ { \"trigger_id\": $json.trigger_id, \"processed_data\": $json.processed_data, \"processing_time\": $json.processing_time, \"processing_status\": $json.processing_status, \"debug_info\": $json.debug_info, \"completed_at\": $now } }}"
            },
            {
              "name": "success_message",
              "value": "✅ Advanced trigger processing completed successfully"
            }
          ]
        }
      },
      "id": "advanced-result-processing",
      "typeVersion": 3.4,
      "position": [
        1920,
        300
      ]
    },
    {
      "name": "Handle Validation Error",
      "type": "n8n-nodes-base.set",
      "position": [
        500,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "validation_error",
              "value": "={{ { \"error_type\": \"validation_failed\", \"trigger_id\": $json.trigger_id, \"message\": \"Data validation failed\", \"timestamp\": $now } }}"
            },
            {
              "name": "error_response",
              "value": "={{ { \"status\": \"error\", \"trigger_id\": $json.trigger_id, \"message\": \"Advanced trigger validation failed\" } }}"
            }
          ]
        }
      },
      "id": "handle-validation-error",
      "typeVersion": 3.4
    }
  ],
