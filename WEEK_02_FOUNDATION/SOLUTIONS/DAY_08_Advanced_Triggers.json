{
  "name": "Day 08 Solution: Understanding Triggers Deep Dive",
  "description": "Three trigger patterns: webhook validation with success/error response, schedule with business-hours branching, and two trigger types sharing one validation IF node.",
  "tags": [
    "week-02",
    "day-08",
    "solution"
  ],
  "version": "1.0.0",
  "nodes": [
    {
      "id": "sticky1",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        40,
        -300
      ],
      "parameters": {
        "content": "## Day 08 Solution: Understanding Triggers Deep Dive\n\nThree workflows: (1) Webhook -> IF validate type+data -> Set -> Respond, (2) Schedule (every 2h) -> IF business-hours check -> Set, (3) both Manual and Webhook feeding the same shared validation IF node. Credentials needed: None needed to test the logic.\n\nSee DAILY_TASKS/DAY_08_Advanced_Triggers.md.",
        "height": 280,
        "width": 480
      }
    },
    {
      "id": "webhook1",
      "name": "Conditional Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        80,
        100
      ],
      "parameters": {
        "path": "advanced-webhook",
        "httpMethod": "POST"
      }
    },
    {
      "id": "if1",
      "name": "Validate Data",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        320,
        100
      ],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.type }}",
              "operation": "isNotEmpty"
            },
            {
              "value1": "={{ $json.data }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      }
    },
    {
      "id": "set1",
      "name": "Process Valid Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        560,
        40
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "processed_type",
              "value": "={{ $json.type }}"
            },
            {
              "name": "processed_data",
              "value": "={{ $json.data }}"
            },
            {
              "name": "processed_at",
              "value": "={{ $now }}"
            },
            {
              "name": "status",
              "value": "processed"
            }
          ]
        }
      }
    },
    {
      "id": "resp1",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        800,
        40
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"success\", \"processed_at\": $json.processed_at } }}"
      }
    },
    {
      "id": "set2",
      "name": "Validation Failed",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        560,
        200
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "status",
              "value": "error"
            }
          ]
        }
      }
    },
    {
      "id": "resp2",
      "name": "Respond Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        800,
        200
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"error\", \"message\": \"Missing type or data\" } }}",
        "options": {
          "responseCode": 400
        }
      }
    },
    {
      "id": "sched1",
      "name": "Business Hours Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        80,
        360
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 2
            }
          ]
        }
      }
    },
    {
      "id": "if2",
      "name": "Check Business Hours",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        320,
        360
      ],
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $now.hour() }}",
              "operation": "largerEqual",
              "value2": 9
            },
            {
              "value1": "={{ $now.hour() }}",
              "operation": "smaller",
              "value2": 17
            }
          ]
        }
      }
    },
    {
      "id": "set3",
      "name": "Business Hours Task",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        560,
        320
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "task_type",
              "value": "business_hours_task"
            },
            {
              "name": "executed_at",
              "value": "={{ $now }}"
            },
            {
              "name": "is_business_hours",
              "value": true
            }
          ]
        }
      }
    },
    {
      "id": "set4",
      "name": "Off Hours Task",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        560,
        460
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "task_type",
              "value": "off_hours_task"
            },
            {
              "name": "executed_at",
              "value": "={{ $now }}"
            },
            {
              "name": "is_business_hours",
              "value": false
            }
          ]
        }
      }
    },
    {
      "id": "trigger1",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        80,
        600
      ],
      "parameters": {}
    },
    {
      "id": "webhook2",
      "name": "Shared Validation Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        80,
        700
      ],
      "parameters": {
        "path": "shared-validation",
        "httpMethod": "POST"
      }
    },
    {
      "id": "if3",
      "name": "Shared Validate Data",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        320,
        650
      ],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.type }}",
              "operation": "isNotEmpty"
            },
            {
              "value1": "={{ $json.data }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      }
    },
    {
      "id": "set5",
      "name": "Shared Process Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        560,
        590
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "processed_type",
              "value": "={{ $json.type }}"
            },
            {
              "name": "processed_data",
              "value": "={{ $json.data }}"
            }
          ]
        }
      }
    },
    {
      "id": "set6",
      "name": "Shared Validation Failed",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        560,
        720
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "status",
              "value": "error"
            }
          ]
        }
      }
    }
  ],
  "connections": {
    "Conditional Webhook": {
      "main": [
        [
          {
            "node": "Validate Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Data": {
      "main": [
        [
          {
            "node": "Process Valid Data",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Validation Failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process Valid Data": {
      "main": [
        [
          {
            "node": "Respond Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validation Failed": {
      "main": [
        [
          {
            "node": "Respond Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
