      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        40,
        -320
      ],
      "parameters": {
        "content": "## Day 09 Solution: Advanced Self-Hosting Setup\n\nDay 9 is infrastructure hardening (env vars, healthcheck path, SSL/pool settings on Render), not a workflow build. This file documents the checklist plus a healthcheck-style self-test and a scheduled backup pattern (Schedule -> HTTP export -> Write file) referenced in the Industry Track note. Credentials needed: None needed to test the logic in n8n itself — Render/PostgreSQL/UptimeRobot accounts are needed for the real deployment (outside n8n).\n\nSee DAILY_TASKS/DAY_09_Self_Hosting_Setup.md.",
        "height": 300,
        "width": 500
      }
    },
    {
      "id": "trigger1",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        80,
        140
      ],
      "parameters": {}
    },
    {
      "id": "set1",
      "name": "Env Var Checklist",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        320,
        140
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "required_env_vars",
              "value": "={{ ['N8N_BASIC_AUTH_ACTIVE=true', 'N8N_BASIC_AUTH_USER', 'N8N_BASIC_AUTH_PASSWORD', 'WEBHOOK_URL', 'GENERIC_TIMEZONE=UTC', 'N8N_ENCRYPTION_KEY', 'DB_POSTGRESDB_SSL_ENABLED=true', 'DB_POSTGRESDB_CONNECTION_TIMEOUT=10000', 'DB_POSTGRESDB_POOL_SIZE=10'] }}"
            },
            {
              "name": "health_check_path",
              "value": "/healthz"
            }
          ]
        }
      }
    },
    {
      "id": "http1",
      "name": "Check Health Endpoint",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        560,
        140
      ],
      "parameters": {
        "method": "GET",
        "url": "https://httpbin.org/status/200",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "if1",
      "name": "Is Healthy (200)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        800,
        140
      ],
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.statusCode }}",
              "operation": "equal",
              "value2": 200
            }
          ]
        }
      }
    },
    {
      "id": "set2",
      "name": "Instance Healthy",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1040,
        60
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "health_status",
              "value": "healthy"
            }
          ]
        }
      }
    },
    {
      "id": "set3",
      "name": "Instance Unhealthy",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1040,
        220
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "health_status",
              "value": "unhealthy - check env vars"
            }
          ]
        }
      }
    },
    {
      "id": "sched1",
      "name": "Scheduled Backup Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
