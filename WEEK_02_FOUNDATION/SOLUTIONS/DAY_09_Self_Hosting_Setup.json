      "position": [
        560,
        400
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "backup_completed_at",
              "value": "={{ $now }}"
            },
            {
              "name": "backup_folder",
              "value": "={{ 'n8n-backups/' + $now.format('yyyyMMdd') }}"
            }
          ]
        }
      }
    }
