            {
              "field": "hours",
              "hoursInterval": 24
            }
          ]
        }
      }
    },
    {
      "id": "http2",
      "name": "Export Postgres Snapshot (placeholder)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        320,
        400
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.backup-service.com/v1/export",
        "sendBody": true,
        "bodyContentType": "json",
        "jsonBody": "={{ { source: 'n8n-postgres', requested_at: $now } }}"
      }
    },
    {
      "id": "sticky2",
