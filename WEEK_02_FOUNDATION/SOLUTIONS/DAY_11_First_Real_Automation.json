{
  "name": "Day 11 Solution: Your First Real Automation",
  "description": "Full pipeline: webhook -> validate -> transform -> notify (Slack) -> log (Google Sheets) -> respond, with a distinct error path.",
  "tags": [
    "week-02",
    "day-11",
    "solution"
  ],
  "version": "1.0.0",
  "nodes": [
    {
      "id": "sticky1",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        40,
        -300
      ],
      "parameters": {
        "content": "## Day 11 Solution: Your First Real Automation\n\nWebhook -> IF validate name+email -> Set (process) -> Set (format) -> Slack notification + Google Sheets log -> Respond success. False branch responds with a 400 error. Credentials needed: Slack API credential (or swap for Telegram) and Google Sheets OAuth2 credential to actually deliver/log; the branching logic can be tested without them.\n\nSee DAILY_TASKS/DAY_11_First_Real_Automation.md.",
        "height": 280,
        "width": 500
      }
    },
    {
      "id": "webhook1",
      "name": "Form Submission Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        80,
        140
      ],
      "parameters": {
        "path": "form-submission",
        "httpMethod": "POST"
      }
    },
    {
      "id": "if1",
      "name": "Validate Form Data",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        320,
        140
      ],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.name }}",
              "operation": "isNotEmpty"
            },
            {
              "value1": "={{ $json.email }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      }
    },
    {
      "id": "set1",
      "name": "Process Form Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        560,
        60
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "submission_id",
              "value": "={{ $now.format('yyyyMMddHHmmss') }}"
            },
            {
              "name": "processed_name",
              "value": "={{ $json.name.trim() }}"
            },
            {
              "name": "processed_email",
              "value": "={{ $json.email.toLowerCase().trim() }}"
            },
            {
              "name": "processed_message",
              "value": "={{ $json.message || 'No message provided' }}"
            },
            {
              "name": "submitted_at",
              "value": "={{ $now }}"
            }
          ]
        }
      }
    },
    {
      "id": "set2",
      "name": "Format Notification",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        800,
        60
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "notification_message",
              "value": "=*Name:* {{ $json.processed_name }}\\n*Email:* {{ $json.processed_email }}\\n*Message:* {{ $json.processed_message }}"
            }
          ]
        }
      }
    },
    {
      "id": "slack1",
      "name": "Send Notification",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.1,
      "position": [
        1040,
        0
      ],
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "slackApi",
        "resource": "message",
        "operation": "post",
        "channel": "#leads",
        "text": "={{ $json.notification_message }}",
        "otherOptions": {}
      }
    },
    {
      "id": "sheets1",
      "name": "Log to Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1040,
        140
      ],
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "your_spreadsheet_id",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Sheet1",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "submission_id": "={{ $json.submission_id }}",
            "processed_name": "={{ $json.processed_name }}",
            "processed_email": "={{ $json.processed_email }}",
            "processed_message": "={{ $json.processed_message }}",
            "submitted_at": "={{ $json.submitted_at }}"
          },
          "matchingColumns": [],
          "schema": []
        }
      }
    },
    {
      "id": "resp1",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1280,
        60
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"success\", \"submission_id\": $json.submission_id } }}"
      }
    },
    {
      "id": "set3",
      "name": "Invalid Form Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        560,
        260
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "status",
              "value": "error"
            }
          ]
        }
      }
    },
    {
      "id": "resp2",
      "name": "Respond Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        800,
        260
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"error\", \"message\": \"Invalid form data\" } }}",
        "options": {
          "responseCode": 400
        }
      }
    }
  ],
  "connections": {
    "Form Submission Webhook": {
      "main": [
        [
          {
            "node": "Validate Form Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Form Data": {
      "main": [
        [
          {
            "node": "Process Form Data",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Invalid Form Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process Form Data": {
      "main": [
        [
          {
            "node": "Format Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Notification": {
      "main": [
        [
          {
            "node": "Send Notification",
            "type": "main",
            "index": 0
          },
          {
            "node": "Log to Sheet",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Notification": {
      "main": [
        [
          {
            "node": "Respond Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log to Sheet": {
      "main": [
        [
          {
            "node": "Respond Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Invalid Form Data": {
      "main": [
        [
          {
            "node": "Respond Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {},
  "pinData": {},
  "versionId": "1",
  "id": "day_11_solution"
}