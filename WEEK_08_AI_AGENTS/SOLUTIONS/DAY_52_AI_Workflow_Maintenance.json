{
  "name": "Day 52 Solution: AI Workflow Maintenance",
  "description": "A daily scheduled health check that pings the Day 51 production webhook and logs a healthy or unhealthy maintenance entry.",
  "tags": ["week8", "ai-agents", "maintenance"],
  "version": "1.0.0",
  "nodes": [
    {
      "id": "overview-sticky",
      "name": "Overview",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [160, 20],
      "parameters": {
        "content": "## Day 52 Solution: AI Workflow Maintenance\n\nA separate Schedule Trigger workflow that pings your Day 51 production webhook once a day, checks the response shape (not just the HTTP status), and writes a maintenance log entry to either the Healthy or Unhealthy branch.\n\n**Credentials needed to run for real:** None — this only calls your own deployed webhook over HTTP.\n\nSee DAILY_TASKS/DAY_52_AI_Workflow_Maintenance.md for the full task.",
        "height": 260,
        "width": 420
      }
    },
    {
      "id": "schedule-trigger",
      "name": "Daily Maintenance Check",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 380],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "ping-production-webhook",
      "name": "Ping Production Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [490, 380],
      "parameters": {
        "method": "POST",
        "url": "https://your-n8n-instance.example.com/webhook/ai-agent-deploy",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "scenario",
              "value": "maintenance ping"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 10000
        }
      }
    },
    {
      "id": "placeholder-sticky",
      "name": "Placeholder Endpoint Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [460, 620],
      "parameters": {
        "content": "## ⚠️ Placeholder endpoint\n\nReplace `https://your-n8n-instance.example.com/webhook/ai-agent-deploy` with your actual Day 51 production webhook URL before running this for real.",
        "height": 160,
        "width": 320
      }
    },
    {
      "id": "check-health-status",
      "name": "Check Health Status",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [740, 380],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-status-deployed",
              "leftValue": "={{ $json.status }}",
              "rightValue": "deployed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "log-healthy-entry",
      "name": "Log Healthy Entry",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [990, 260],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "timestamp",
              "value": "={{ $now.toISO() }}"
            },
            {
              "name": "workflow_checked",
              "value": "AI Agent Deploy Demo (Day 51)"
            },
            {
              "name": "result",
              "value": "healthy"
            }
          ]
        }
      }
    },
    {
      "id": "build-alert-message",
      "name": "Build Alert Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [990, 500],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "alert_workflow_name",
              "value": "AI Agent Deploy Demo (Day 51)"
            },
            {
              "name": "alert_timestamp",
              "value": "={{ $now.toISO() }}"
            },
            {
              "name": "alert_what_failed",
              "value": "={{ 'Ping response status was \\'' + ($json.status || 'unknown') + '\\' instead of \\'deployed\\' — the production webhook may be inactive or returning an unexpected payload.' }}"
            }
          ]
        }
      }
    },
    {
      "id": "log-failed-entry",
      "name": "Log Failed Entry",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1240, 500],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "timestamp",
              "value": "={{ $json.alert_timestamp }}"
            },
            {
              "name": "workflow_checked",
              "value": "={{ $json.alert_workflow_name }}"
            },
            {
              "name": "result",
              "value": "unhealthy"
            },
            {
              "name": "failure_reason",
              "value": "={{ $json.alert_what_failed }}"
            }
          ]
        }
      }
    }
  ],
  "connections": {
    "Daily Maintenance Check": {
      "main": [
        [
          { "node": "Ping Production Webhook", "type": "main", "index": 0 }
        ]
      ]
    },
    "Ping Production Webhook": {
      "main": [
        [
          { "node": "Check Health Status", "type": "main", "index": 0 }
        ]
      ]
    },
    "Check Health Status": {
      "main": [
        [
          { "node": "Log Healthy Entry", "type": "main", "index": 0 }
        ],
        [
          { "node": "Build Alert Message", "type": "main", "index": 0 }
        ]
      ]
    },
    "Build Alert Message": {
      "main": [
        [
          { "node": "Log Failed Entry", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "active": false,
  "settings": {},
  "pinData": {},
  "versionId": "1",
  "id": "day_52_solution"
}
